# === TheWorkshop Backend Environment Variables ===
# Copy this file to .env and fill in your values

# JWT Secret Key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# Database URL — PostgreSQL connection string
# For Supabase: postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./database.db

# Comma-separated list of allowed frontend origins
FRONTEND_URLS=http://localhost:5173,http://localhost:3000

# Google Gemini API Key for AI Tutor & Flashcards
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Admin email — this user will be auto-promoted to admin on startup
ADMIN_EMAIL=admin@example.com

# Supabase — used for file storage (tutor documents, diagrams)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Paystack payment keys (get these from your Paystack dashboard)
# Use test keys during development, switch to live keys for production
PAYSTACK_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY_HERE

# Paystack recurring plan codes (create these in your Paystack dashboard)
PAYSTACK_PLAN_PRO=
PAYSTACK_PLAN_PREMIUM=
PAYSTACK_PLAN_MAX=

# The frontend URL (used for Paystack callback redirect)
FRONTEND_URL=http://localhost:5173

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Data entry endpoint admin token — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty to disable the data entry upload endpoint
DATA_ENTRY_TOKEN=

# Modal AI processing URLs — set after deploying Modal functions
MODAL_GRADER_URL=
MODAL_PAPER_PROCESSOR_URL=
MODAL_UPSCALER_URL=

# Shared secret for Modal webhook authentication
MODAL_SHARED_SECRET=
